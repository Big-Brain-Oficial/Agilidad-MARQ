{
  "name": "marq-experience",
  "version": "0.3.0",
  "private": true,
  "description": "MARQ Experience: mapa 2D de desarrollos + recorrido 3D en primera persona",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "model:build": "node scripts/build-model.mjs",
    "archviz:assets": "node scripts/archviz-assets.mjs",
    "unreal:prepare": "node scripts/unreal/prepare.mjs",
    "unreal:import": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unreal/Import-Natalini.ps1",
    "unreal:stream": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unreal/Start-Natalini.ps1",
    "unreal:setup-streaming": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unreal/Setup-Streaming.ps1",
    "unreal:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unreal/Start-Signalling.ps1",
    "unreal:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/unreal/Start-WebPreview.ps1"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "maplibre-gl": "^6.13.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
